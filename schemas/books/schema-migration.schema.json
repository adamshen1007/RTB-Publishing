{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtb-publishing.local/schemas/books/schema-migration.schema.json",
  "title": "Schema Migration Report", "type": "object", "additionalProperties": false,
  "required": ["id", "schema_version", "created_at", "updated_at", "producer", "validation_rules", "record_type", "from_version", "to_version", "input_hash", "output_hash", "status", "changes", "rollback_limit", "canonical_source_unchanged"],
  "properties": { "id": { "$ref": "#/$defs/stableId" }, "schema_version": { "const": "1" }, "created_at": { "$ref": "#/$defs/timestamp" }, "updated_at": { "$ref": "#/$defs/timestamp" }, "producer": { "$ref": "#/$defs/actor" }, "validation_rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,79}$" } }, "record_type": { "enum": ["book-project", "book-blueprint", "book-chapter"] }, "from_version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "to_version": { "const": "1" }, "input_hash": { "$ref": "#/$defs/hash" }, "output_hash": { "$ref": "#/$defs/hash" }, "status": { "enum": ["migrated", "unchanged", "blocked"] }, "changes": { "type": "array", "items": { "type": "string" } }, "rollback_limit": { "type": "string", "minLength": 1 }, "canonical_source_unchanged": { "type": "boolean" } },
  "$defs": { "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){1,79}$" }, "timestamp": { "type": "string", "format": "date-time" }, "actor": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.@-]{1,127}$" }, "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
