{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtb-publishing.local/schemas/books/book-project.schema.json",
  "title": "Book Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "created_at", "updated_at", "producer", "validation_rules", "content_hash", "locale", "paths", "output_profiles", "blueprint", "lifecycle"],
  "properties": {
    "id": { "$ref": "#/$defs/stableId" },
    "schema_version": { "const": "1" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "producer": { "$ref": "#/$defs/actor" },
    "validation_rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,79}$" } },
    "content_hash": { "$ref": "#/$defs/hash" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3}|-[A-Z]{2})?$" },
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "metadata", "chapters", "assets"],
      "properties": {
        "root": { "$ref": "#/$defs/path" }, "metadata": { "$ref": "#/$defs/path" },
        "chapters": { "$ref": "#/$defs/path" }, "assets": { "$ref": "#/$defs/path" },
        "research": { "$ref": "#/$defs/path" }, "reviews": { "$ref": "#/$defs/path" }
      }
    },
    "output_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["id", "format", "path"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "format": { "enum": ["html", "pdf", "epub"] }, "path": { "$ref": "#/$defs/path" } } } },
    "blueprint": { "type": "object", "additionalProperties": false, "required": ["id", "path", "content_hash"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "path": { "$ref": "#/$defs/path" }, "content_hash": { "$ref": "#/$defs/hash" } } },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["id", "path", "content_hash"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "path": { "$ref": "#/$defs/path" }, "content_hash": { "$ref": "#/$defs/hash" } } }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){1,79}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.@-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  }
}
