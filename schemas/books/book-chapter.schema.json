{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtb-publishing.local/schemas/books/book-chapter.schema.json",
  "title": "Book Chapter Contract", "type": "object", "additionalProperties": false,
  "required": ["id", "schema_version", "created_at", "updated_at", "producer", "validation_rules", "content_hash", "title", "order", "source_path", "reader_decision", "required_output"],
  "properties": { "id": { "$ref": "#/$defs/stableId" }, "schema_version": { "const": "1" }, "created_at": { "$ref": "#/$defs/timestamp" }, "updated_at": { "$ref": "#/$defs/timestamp" }, "producer": { "$ref": "#/$defs/actor" }, "validation_rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,79}$" } }, "content_hash": { "$ref": "#/$defs/hash" }, "title": { "type": "string", "minLength": 1, "maxLength": 500 }, "order": { "type": "integer", "minimum": 1 }, "part_id": { "$ref": "#/$defs/stableId" }, "source_path": { "$ref": "#/$defs/path" }, "reader_decision": { "type": "string", "minLength": 1, "maxLength": 1000 }, "required_output": { "type": "string", "minLength": 1, "maxLength": 1000 } },
  "$defs": { "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){1,79}$" }, "timestamp": { "type": "string", "format": "date-time" }, "actor": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.@-]{1,127}$" }, "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$" } }
}
