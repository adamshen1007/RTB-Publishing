{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtb-publishing.local/schemas/books/book-blueprint.schema.json",
  "title": "Book Blueprint",
  "type": "object", "additionalProperties": false,
  "required": ["id", "schema_version", "created_at", "updated_at", "producer", "validation_rules", "content_hash", "project_id", "reader", "promised_outcome", "scope", "thesis", "source_policy", "budgets", "provider_egress_policy", "parts", "chapter_contracts", "materiality_rules"],
  "properties": {
    "id": { "$ref": "#/$defs/stableId" }, "schema_version": { "const": "1" }, "created_at": { "$ref": "#/$defs/timestamp" }, "updated_at": { "$ref": "#/$defs/timestamp" }, "producer": { "$ref": "#/$defs/actor" }, "validation_rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,79}$" } }, "content_hash": { "$ref": "#/$defs/hash" },
    "project_id": { "$ref": "#/$defs/stableId" }, "reader": { "type": "object", "additionalProperties": false, "required": ["description"], "properties": { "description": { "type": "string", "minLength": 1, "maxLength": 2000 }, "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3}|-[A-Z]{2})?$" } } },
    "promised_outcome": { "type": "string", "minLength": 1, "maxLength": 2000 }, "scope": { "type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": { "included": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 } } } }, "thesis": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "source_policy": { "type": "object", "additionalProperties": false, "required": ["allowed_tiers", "rights_requirement", "freshness_days"], "properties": { "allowed_tiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["primary", "secondary", "manual", "metadata-only"] } }, "rights_requirement": { "enum": ["required", "manual-review"] }, "freshness_days": { "type": "integer", "minimum": 0, "maximum": 36500 } } },
    "budgets": { "type": "object", "additionalProperties": false, "required": ["research_items", "provider_cost_usd"], "properties": { "research_items": { "type": "integer", "minimum": 0 }, "provider_cost_usd": { "type": "number", "minimum": 0 } } }, "provider_egress_policy": { "type": "object", "additionalProperties": false, "required": ["classification", "allowed_providers"], "properties": { "classification": { "enum": ["local-only", "approved-external"] }, "allowed_providers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" } } } },
    "parts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "order"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "title": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 1 } } } },
    "chapter_contracts": { "type": "array", "minItems": 1, "items": { "$ref": "book-chapter.schema.json" } }, "materiality_rules": { "type": "object", "additionalProperties": false, "required": ["fields_requiring_reapproval"], "properties": { "fields_requiring_reapproval": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["reader", "promised_outcome", "scope", "thesis", "chapter_contracts", "source_policy", "budgets", "provider_egress_policy"] } } } }
  },
  "$defs": { "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){1,79}$" }, "timestamp": { "type": "string", "format": "date-time" }, "actor": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.@-]{1,127}$" }, "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
