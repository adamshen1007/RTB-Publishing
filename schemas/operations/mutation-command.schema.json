{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtb-publishing.local/schemas/operations/mutation-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "command", "projectId", "actor", "expectedSnapshotHash", "expectedLifecycleVersion", "expectedLifecycleGuard", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^MUT-[A-Z0-9-]{3,64}$" },
    "command": { "const": "replace_files" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "actor": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[A-Za-z0-9._@-]+$" },
    "expectedSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expectedLifecycleVersion": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "expectedLifecycleGuard": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "content", "expectedHash"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "content": { "type": "string", "maxLength": 65536 },
          "expectedHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
