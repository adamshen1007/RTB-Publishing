{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtb-publishing.local/schemas/publishing/release-candidate.schema.json",
  "type": "object",
  "required": ["schemaVersion", "projectId", "lifecycleVersion", "sourceFingerprint", "snapshot", "artifacts", "validators", "policies", "futureStaging", "candidateHash"],
  "properties": {
    "schemaVersion": { "const": 1 }, "projectId": { "type": "string" }, "lifecycleVersion": { "type": "integer", "minimum": 0 }, "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "snapshot": { "type": "object", "required": ["repository", "bundle"], "properties": { "repository": { "type": "object", "required": ["revision", "tree"], "properties": { "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" } } }, "bundle": { "type": "object", "required": ["path", "files"], "properties": { "path": { "const": "source-snapshot" }, "files": { "type": "array", "minItems": 1 } } } } }, "artifacts": { "type": "object", "required": ["html", "pdf", "epub"] }, "validators": { "type": "object" }, "policies": { "type": "object" }, "futureStaging": { "type": "object" }, "candidateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
